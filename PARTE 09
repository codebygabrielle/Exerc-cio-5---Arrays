INÍCIO
i ← 0
ENQUANTO (i < 6) FAÇA
    ESCREVER "Informe o valor par ", i + 1, ":"
    LER V[i]
    ENQUANTO (V[i] MOD 2 != 0) FAÇA
        ESCREVER "Valor inválido, informe um número par:"
        LER V[i]
    FIM_ENQUANTO
    i ← i + 1
FIM_ENQUANTO

ESCREVER "Valores na ordem inversa:"
i ← 5
ENQUANTO (i >= 0) FAÇA
    ESCREVER V[i]
    i ← i - 1
FIM_ENQUANTO
FIM
