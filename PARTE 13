INÍCIO
i ← 0
ENQUANTO (i < 5) FAÇA
    ESCREVER "Informe o valor ", i + 1, ":"
    LER V[i]
    i ← i + 1
FIM_ENQUANTO

maior ← V[0]
menor ← V[0]
posMaior ← 0
posMenor ← 0
i ← 1
ENQUANTO (i < 5) FAÇA
    SE (V[i] > maior) ENTÃO
        maior ← V[i]
        posMaior ← i
    FIM_SE
    SE (V[i] < menor) ENTÃO
        menor ← V[i]
        posMenor ← i
    FIM_SE
    i ← i + 1
FIM_ENQUANTO

ESCREVER "Posição do maior valor: ", posMaior
ESCREVER "Posição do menor valor: ", posMenor
FIM
